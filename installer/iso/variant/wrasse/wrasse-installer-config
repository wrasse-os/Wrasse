#!/usr/bin/bash
# Live ISO boot step: pick the installer image catalog for the detected graphics flavor.
#
# Runs wrasse-gpu-detect (Turing or newer NVIDIA -> wrasse-nvidia, else wrasse; override with
# wrasse.gpu=nvidia|default on the kernel command line) and installs the matching pre-generated
# catalog (images.wrasse.json or images.wrasse-nvidia.json, from installer/gen-catalog.sh) as
# /etc/bootc-installer/images.json. The detected flavor is baked into each release line's imgref;
# the catalog's last group offers the other graphics variant as the override.
set -euo pipefail

dir="${WRASSE_INSTALLER_CATALOG_DIR:-/usr/share/wrasse/installer}"
out="${WRASSE_INSTALLER_CATALOG:-/etc/bootc-installer/images.json}"

flavor="$(wrasse-gpu-detect --explain)" || flavor=wrasse
case "${flavor}" in
    wrasse | wrasse-nvidia) ;;
    *) echo "wrasse-installer-config: unexpected detect output '${flavor}', using wrasse" >&2; flavor=wrasse ;;
esac

mkdir -p "$(dirname "${out}")"
tmp="$(mktemp "${out}.XXXXXX")"
cp "${dir}/images.${flavor}.json" "${tmp}"
chmod 0644 "${tmp}"
mv -f "${tmp}" "${out}"
echo "wrasse-installer-config: installed the ${flavor} catalog"
