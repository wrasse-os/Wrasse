# Pins for .github/workflows/build-iso.yml. Bump these on purpose, never to "latest".
#
# bootc-installer: tuna-os/bootc-installer is the live upstream. projectbluefin/bootc-installer
# (the repo the spec names) is archived (last push 2026-09-07) and dakota-iso, the ISO tooling
# Bluefin uses, downloads from tuna-os now.
INSTALLER_REPO=tuna-os/bootc-installer
INSTALLER_TAG=v2026.09.26-253d6938
# sha256 of org.bootcinstaller.Installer.flatpak in that release (GitHub asset digest).
INSTALLER_FLATPAK_SHA256=980bbddb4ae24d3a1bf654ac46efe19aea64bcf4ce8cfb0108135a48549768d3

# ISO tooling: projectbluefin/dakota-iso (live container, squashfs and ISO assembly scripts), pinned to a commit.
ISO_TOOLING_REPO=projectbluefin/dakota-iso
ISO_TOOLING_REF=9c123eea4817fc5bd3b7fe2fc021c49f69818cfa
